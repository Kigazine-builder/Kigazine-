{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/verify-email.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "appletimes.kigazine.com"
        }
      ],
      "destination": "/apple-times.html"
    }
  ]
}
